HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — local dev only.
#
# WARNING for Strapi Cloud: never copy these into the Cloud dashboard. Setting any
# variable starting with DATABASE_ makes Cloud assume you are bringing your own
# database and stop injecting its managed Postgres credentials, which would boot
# the deployed app on an ephemeral SQLite file that is wiped on every deploy.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Comma-separated list of frontend origins allowed to call this API (CORS)
FRONTEND_URLS=http://localhost:3000,https://rouge-creations-website.vercel.app

# Resend (https://resend.com) — used to email the team when a new event
# inquiry is submitted through the website's contact form
RESEND_API_KEY=
EMAIL_FROM="Rouge Creations <onboarding@resend.dev>"
EMAIL_REPLY_TO=
# Inbox that receives new event inquiry notifications (defaults to EMAIL_FROM)
NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Strapi Cloud
#
# Set in the project dashboard, not here: APP_KEYS, API_TOKEN_SALT,
# ADMIN_JWT_SECRET, TRANSFER_TOKEN_SALT, JWT_SECRET, ENCRYPTION_KEY,
# FRONTEND_URLS, RESEND_API_KEY, EMAIL_FROM, EMAIL_REPLY_TO, NOTIFY_EMAIL.
#
# Leave to Cloud: HOST, PORT, NODE_ENV, and every DATABASE_* variable.
# ---------------------------------------------------------------------------
