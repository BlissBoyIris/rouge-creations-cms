    },
    "blurb": {
      "type": "text",
      "required": true
    },
    "detail": {
      "type": "richtext"
    },
    "includes": {
      "type": "text"
    },
    "excludes": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
